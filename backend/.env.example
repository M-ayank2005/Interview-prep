# Environment Variables - Copy this file to .env and update values
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/interview-prep
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated allowlist for multiple frontend domains
# FRONTEND_URLS=http://localhost:3000,https://your-frontend.vercel.app,https://*.vercel.app
LOG_LEVEL=debug
